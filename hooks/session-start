#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

using_magic_powers=$(cat "${PLUGIN_ROOT}/skills/using-magic-powers/SKILL.md" 2>&1 || echo "Error reading using-magic-powers skill")

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

content_escaped=$(escape_for_json "$using_magic_powers")
session_context="<EXTREMELY_IMPORTANT>\\nYou have magic-powers.\\n\\n**Below is your 'magic-powers:using-magic-powers' skill. For all other skills, use the 'Skill' tool:**\\n\\n${content_escaped}\\n</EXTREMELY_IMPORTANT>"

if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
fi

exit 0
